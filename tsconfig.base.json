{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "types": ["vitest/globals"],
    "paths": {
      "@opencode/*": [
        "packages/*/dist",
        "packages/*/src"
      ]
    }
  }
}
